DATABASE_URL=postgresql://solivio:solivio@localhost:5432/solivio

# Default currency used when creating offers (ISO 4217 code, e.g. PLN, EUR, USD).
DEFAULT_CURRENCY=PLN

OPENAI_API_KEY=
# Per-role model overrides. Leave empty to use code defaults from
# src/server/runtime/ai/modelConfig.ts (full/mini/nano per role).
OPENAI_MODEL_OFFER_GENERATION=
OPENAI_MODEL_OFFER_VALIDATION=
OPENAI_MODEL_OFFER_NAME=
OPENAI_MODEL_CHAT=
OPENAI_MODEL_PRODUCT_SEARCH=
# Empty = code default (text-embedding-3-large).
EMBEDDING_MODEL=

# ── Better Auth ────────────────────────────────────────────────────────────────
# App URL used by Better Auth for redirects and CORS.
BETTER_AUTH_URL=http://localhost:3000

# Required in production — generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Auth form options ──────────────────────────────────────────────────────────
# Set to false to remove the sign-up form (invite-only / admin-provisioned users).
AUTH_SIGNUP_ENABLED=true

# Role assigned to new sign-ups. Defaults to "admin" for easy local onboarding.
# Set to "user" in shared or production-like environments.
AUTH_SIGNUP_DEFAULT_ROLE=admin

# Set to false to hide email/password login and force SSO-only.
AUTH_CREDENTIALS_ENABLED=true

# Set to false to hide OAuth buttons and force credentials-only login.
AUTH_SSO_ENABLED=true

# Set to true when users arrive via external SSO: hides Change Password /
# Log Out in the app's own user menu. Independent of AUTH_CREDENTIALS_ENABLED
# — /login and its credentials form stay reachable, so an admin can still sign
# in directly without going through SSO.
AUTH_SSO_ONLY=false

# ── OAuth providers ────────────────────────────────────────────────────────────
# Buttons appear automatically when CLIENT_ID is set (and AUTH_SSO_ENABLED is true).

# Google — https://console.cloud.google.com/
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID — https://entra.microsoft.com/
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
# Optional: restrict to a specific tenant. Omit or set "common" to allow any Microsoft account.
AUTH_MICROSOFT_TENANT_ID=common

# ── External SSO ───────────────────────────────────────────────────────────────
# Lets a trusted external system sign users in, using the shape of the OIDC
# authorization-code flow. Solivio starts it, so the issuer needs two endpoints:
#
#   1. The browser opens /api/auth/external-sso/start, which sets a `state`
#      cookie and redirects to SSO_START_URL?state=...
#   2. The issuer identifies the user itself and redirects back to
#      /api/auth/external-sso?code=...&state=... with a one-time code.
#   3. This server POSTs {"code": "..."} to SSO_EXCHANGE_URL with
#      `Authorization: Bearer $SSO_EXCHANGE_API_KEY` and expects
#      {"idToken": "<HS256 JWT>"} back.
#
# The id token must carry `exp`, `iat`, `jti`, and be under two minutes old. Its
# `email` claim identifies the user; a matching account is created on first
# sign-in with AUTH_SIGNUP_DEFAULT_ROLE.

#
# Empty secret or issuer disables both endpoints.
SSO_JWT_SECRET=
# Expected `iss` claim - identifies the system allowed to mint these tokens.
SSO_JWT_ISSUER=
# Expected `aud` claim. Defaults to "solivio-app" when unset.
SSO_JWT_AUDIENCE=solivio-app

# Where to send the browser to be identified, and the back channel to redeem the
# code it returns with. Both unset leaves /external-sso/start redirecting to
# /login?error=sso_not_configured.
SSO_START_URL=
SSO_EXCHANGE_URL=
SSO_EXCHANGE_API_KEY=
