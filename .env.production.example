# Copy to `.env` on the deployment host (next to docker-compose.prod.yml).

APP_HOST=demo.solivio.ai
LETSENCRYPT_EMAIL=ops@solivio.ai

# Pin to a commit SHA for reproducible deploys; "latest" for fast iteration.
IMAGE_TAG=latest

POSTGRES_DB=solivio
POSTGRES_USER=solivio
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://solivio:change-me@db:5432/solivio

OPENAI_API_KEY=
# Per-role model overrides. Leave empty to use code defaults from
# apps/solivio/src/server/runtime/ai/modelConfig.ts (full/mini/nano per role).
OPENAI_MODEL_OFFER_GENERATION=
OPENAI_MODEL_OFFER_VALIDATION=
OPENAI_MODEL_OFFER_NAME=
OPENAI_MODEL_CHAT=
OPENAI_MODEL_PRODUCT_SEARCH=
# Empty = code default (text-embedding-3-large).
EMBEDDING_MODEL=

BETTER_AUTH_URL=https://demo.solivio.ai

# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

AUTH_SIGNUP_ENABLED=true
AUTH_CREDENTIALS_ENABLED=true

# Despite the name, this gates only the Google/Microsoft buttons on /login —
# upstream Solivio's social login, which this deployment does not use. The Odoo
# handshake below is a separate mechanism and is unaffected by this flag.
AUTH_SSO_ENABLED=false

# Role given to users created by sign-up or by first Odoo SSO login. The dev
# example defaults this to "admin" for easy local onboarding — do not carry
# that over.
AUTH_SIGNUP_DEFAULT_ROLE=user

# true hides Change Password / Log Out for users who arrive via Odoo SSO.
# /login stays reachable either way, so an admin can still sign in directly.
AUTH_SSO_ONLY=false

# External SSO — SP-initiated authorization-code flow. The browser is sent to
# SSO_START_URL to be identified, comes back to /api/auth/external-sso with a
# one-time code, and this server redeems that code at SSO_EXCHANGE_URL using
# SSO_EXCHANGE_API_KEY. Only the exchange carries a secret; the browser never
# holds a usable credential.
#
# HS256 secret and expected `iss` of the id token the exchange returns. Either
# one empty disables the endpoints.
SSO_JWT_SECRET=
SSO_JWT_ISSUER=odoo
SSO_JWT_AUDIENCE=solivio-app

# Where to send the browser to authenticate, and the back channel to redeem the
# code it returns with. Against the derave_solivio Odoo addon these are
# <odoo>/solivio/sso/start and <odoo>/solivio/api/sso/exchange.
SSO_START_URL=
SSO_EXCHANGE_URL=
# Same value as the addon's `solivio.api_key` (Settings -> Solivio in Odoo) —
# i.e. the same key as ODOO_API_KEY below, against the same host as ODOO_URL.
# They are separate settings because the odoo module and the auth layer are
# configured independently, but a deployment that sets them inconsistently will
# have one of the two silently failing.
SSO_EXCHANGE_API_KEY=

# ── Odoo integration (the `odoo` module) ──────────────────────────────────────
# Required by the product/customer sync and the offer export. Unset means the
# module throws on its first run rather than degrading.
ODOO_URL=
ODOO_API_KEY=

# ISO 4217 code used when a record or offer omits its currency.
DEFAULT_CURRENCY=PLN
