{
  "name": "@solivio/module-offer-pdf",
  "version": "0.1.0",
  "private": true,
  "description": "PDF channel for the offer target: renders a finalized offer into a PDF document, and the UI slots that show it on the accepted-offer screen.",
  "type": "module",
  "solivio": {
    "module": true
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@solivio/domain": "workspace:*",
    "@solivio/sdk": "workspace:*",
    "@solivio/ui": "workspace:*",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.17.0",
    "react-pdf": "^10.4.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": "*",
    "next-intl": "*",
    "react": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "typescript": "^6.0.3"
  }
}
